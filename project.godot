; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixel Sprite"
run/main_scene="uid://cv73j3jhbhaef"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
config/icon="uid://cbmjmslvp4h4d"
config/windows_native_icon="res://assets/app_icon.ico"

[autoload]

MenuManager="*uid://yt4k544va37f"
AppManager="*uid://n24kdl5sc4k5"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=2
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/registry/plugin.cfg", "res://addons/scene_pool/plugin.cfg", "res://addons/ui_expansion/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "orange",
"res://classes/": "yellow",
"res://core/": "green",
"res://resources/": "teal",
"res://scenes/": "blue",
"res://test/": "gray"
}

[gui]

theme/custom="uid://dy7y087v2scv"

